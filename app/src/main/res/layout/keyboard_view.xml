<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="270dp"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="4dp">

    <!-- 1. Satır: Rakamlar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
    </LinearLayout>

    <!-- 2. Satır: Q W E R T Y U I O P -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_q" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="q" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_w" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="w" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_e" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="e" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_r" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="r" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_t" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="t" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_y" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="y" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_u" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="u" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_i" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ı" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_o" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="o" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_p" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="p" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
    </LinearLayout>

    <!-- 3. Satır: A S D F G H J K L -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_a" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="a" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_s" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="s" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_d" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="d" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_f" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="f" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_g" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="g" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_h" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="h" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_j" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="j" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_k" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="k" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_l" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="l" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
    </LinearLayout>

    <!-- 4. Satır: Shift, Z X C V B N M, Silme -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_shift" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:text="⇧" android:textColor="#FFFFFF" android:backgroundTint="#555555"/>
        <Button android:id="@+id/btn_z" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="z" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_x" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="x" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="c" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="v" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_b" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="b" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_n" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="n" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="m" android:textColor="#FFFFFF" android:backgroundTint="#444444"/>
        <Button android:id="@+id/btn_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:text="⌫" android:textColor="#FFFFFF" android:backgroundTint="#555555"/>
    </LinearLayout>

    <!-- 5. Satır: Ayarlar, SYM, Emoji, Pano, Virgül, Boşluk, Nokta ve Enter -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_settings_panel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:text="⚙" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_symbols" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:text="SYM" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_emoji" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:text="😊" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_clipboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:text="📋" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_comma" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:text="," android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.8" android:text="Boşluk" android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_dot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:text="." android:textColor="#FFFFFF" android:backgroundTint="#333333"/>
        <Button android:id="@+id/btn_enter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.9" android:text="↵" android:textColor="#FFFFFF" android:backgroundTint="#0D6EFD"/>
    </LinearLayout>

</LinearLayout>
